rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    match /app-data/{docId} {

      allow write: if docId in [
                        'app-payslips',
                        'app-announcements',
                        'app-shift-schedule'
                      ]
                      && request.auth != null
                      && request.auth.token.role == 'hrd';

      allow write: if !(docId in [
                        'app-payslips',
                        'app-announcements',
                        'app-shift-schedule'
                      ])
                      && request.auth != null;

      allow read: if request.auth != null;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
